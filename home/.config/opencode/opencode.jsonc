{
  "$schema": "https://opencode.ai/config.json",
  // Off since 2026-08-01: autoupdate once delivered a bad 1.18.10 artifact whose TUI
  // stopped rendering after the first message. Update deliberately via `opencode upgrade`.
  "autoupdate": false,
  "model": "openai/gpt-5.6-terra",
  "small_model": "opencode/deepseek-v4-flash-free",
  "permission": "allow",
  // oca dispatches with agent=<role>; OpenCode 1.18.10 prompt_async silently drops prompts
  // naming an unregistered agent (opencode-axi#60). Role agents must be registered here.
  "agent": {
    "impl": {
      "description": "oca implementer role agent",
      "mode": "primary"
    }
  },
  "provider": {
    "openai": {
      "whitelist": [
        "gpt-5.6-luna",
        "gpt-5.6-luna-fast",
        "gpt-5.6-sol",
        "gpt-5.6-sol-fast",
        "gpt-5.6-terra",
        "gpt-5.6-terra-fast"
      ],
      "models": {
        "gpt-5.6-luna": {
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "xhigh": { "reasoningEffort": "xhigh" },
            "max": { "reasoningEffort": "max" }
          }
        },
        "gpt-5.6-sol": {
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "xhigh": { "reasoningEffort": "xhigh" },
            "max": { "reasoningEffort": "max" }
          }
        },
        "gpt-5.6-terra": {
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "xhigh": { "reasoningEffort": "xhigh" },
            "max": { "reasoningEffort": "max" }
          }
        }
      }
    },
    "opencode": {
      "whitelist": ["deepseek-v4-flash-free"]
    },
    "anthropic": {
      "whitelist": []
    },
    "google": {
      "whitelist": []
    }
  }
}
